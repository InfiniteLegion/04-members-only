<!doctype html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport"
          content="width=device-width, user-scalable=no, initial-scale=1.0, maximum-scale=1.0, minimum-scale=1.0">
    <meta http-equiv="X-UA-Compatible" content="ie=edge">
    <link rel="stylesheet" href="/css/style.css">
    <title>Become member</title>
</head>
<body>
    <div class="main-wrapper">
        <%- include('../partials/navbar') %>

        <div class="content-wrapper">
            <div class="membership-form">
                <h2>Enter secret password and become a member</h2>

                <form action="/user/membership/update" method="post" class="form" id="member-form">
                    <input type="hidden" name="id" value="<%= locals.currentUser && locals.currentUser.id %>">

                    <div class="input-block">
                        <label for="secret">Secret</label>
                        <input type="text" id="secret" name="secret" required>
                        <p class="form-error <% locals.error ? "" : "hidden"%>" id="secret-error">
                            <%= locals.error && error%>
                        </p>
                    </div>

                    <div class="input-btn-block">
                        <button type="submit" class="input-btn btn-submit">Submit</button>
                    </div>
                </form>
            </div>
        </div>

        <%- include('../partials/footer') %>
    </div>

    <script src="/js/membership/membership.js"></script>
</body>
</html>