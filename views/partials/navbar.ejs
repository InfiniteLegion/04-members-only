<nav>
    <ul class="nav-ul">
        <li>
            <a href="/" class="nav-a">Home</a>
        </li>

        <li class="has-dropdown">
            <% if (locals.currentUser) { %>
                <span class="nav-span">Profile</span>

                <ul class="dropdown">
                    <li><a href="/user/log-out" class="nav-a">Log out</a></li>
                </ul>
            <% } else { %>
                <a href="/user/sign-in" class="nav-a">Sign in</a>
            <% } %>
        </li>

        <% if (locals.currentUser && !currentUser.isMember) { %>
            <li>
                <button class="nav-btn">
                    <a href="/user/membership">Become member</a>
                </button>
            </li>
        <% } %>
    </ul>
</nav>