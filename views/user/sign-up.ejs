<!doctype html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport"
          content="width=device-width, user-scalable=no, initial-scale=1.0, maximum-scale=1.0, minimum-scale=1.0">
    <meta http-equiv="X-UA-Compatible" content="ie=edge">
    <link rel="stylesheet" href="/css/style.css">
    <title>Sign up</title>
</head>
<body>
    <div class="main-wrapper">
        <%- include('../partials/navbar') %>

        <div class="content-wrapper">
            <div class="user-form">
                <h2>Sign up</h2>

                <form action="/user/new" method="post" class="form" id="sign-up-form" novalidate>
                    <% if (locals.error) { %>
                        <p class="form-error"><%= error %></p>
                    <% } %>

                    <div class="input-block">
                        <label for="last-name">Last name</label>
                        <input type="text" id="last-name" name="last_name" minlength="2" maxlength="50" required
                            value="<%= locals.formData ? formData.last_name : ""%>">
                        <p class="form-error hidden" id="sign-up-last-name-error"></p>
                    </div>

                    <div class="input-block">
                        <label for="first-name">First name</label>
                        <input type="text" id="first-name" name="first_name" minlength="2" maxlength="50" required
                            value="<%= locals.formData ? formData.first_name : "" %>">
                        <p class="form-error hidden" id="sign-up-first-name-error"></p>
                    </div>

                    <div class="input-block">
                        <label for="username">Username</label>
                        <input type="text" id="username" name="username" minlength="2" required
                            value="<%= locals.formData ? formData.username : "" %>">
                        <p class="form-error hidden" id="sign-up-username-error"></p>
                    </div>

                    <div class="input-block">
                        <label for="email">Email</label>
                        <input type="email" id="email" name="email" required
                            value="<%= locals.formData ? formData.email : "" %>">
                        <p class="form-error hidden" id="sign-up-email-error"></p>
                    </div>

                    <div class="input-block">
                        <label for="password">Password</label>
                        <input type="password" id="password" name="password" required>
                        <p class="form-error hidden" id="sign-up-password-error"></p>
                    </div>

                    <div class="input-block input-block-check">
                        <input type="checkbox" id="show-password">
                        <label for="show-password">Show password</label>
                    </div>

                    <div class="input-btn-block">
                        <button type="submit" class="input-btn btn-submit">Sign up</button>
                        <p>
                            Already have account?
                            <a href="/user/sign-in">Sign in</a>
                        </p>
                    </div>
                </form>
            </div>
        </div>

        <%- include('../partials/footer') %>
    </div>

    <script src="/js/user/sign-up.js"></script>
</body>
</html>